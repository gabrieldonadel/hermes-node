build lib/event-loop/CMakeFiles/hermesNodeEventLoop.dir/uv_event_loop.cpp.o: CXX_COMPILER__hermesNodeEventLoop_unscanned_Release /Users/briones/Developer/hermes-node/lib/event-loop/uv_event_loop.cpp || cmake_object_order_depends_target_hermesNodeEventLoop
  CONFIG = Release
  DEP_FILE = lib/event-loop/CMakeFiles/hermesNodeEventLoop.dir/uv_event_loop.cpp.o.d
  FLAGS = -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-invalid-offsetof -Wmissing-field-initializers -Wno-deprecated-copy -Wno-noexcept-type -Wnon-virtual-dtor -Wdelete-non-virtual-dtor -ffp-contract=on -Wno-range-loop-analysis -O3 -DNDEBUG -std=gnu++17 -arch arm64 -fPIC -fno-exceptions -fno-rtti
