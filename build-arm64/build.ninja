  ARCH_FLAGS = -arch arm64
  CONFIG = Release
  LANGUAGE_COMPILE_FLAGS = -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-invalid-offsetof -Wmissing-field-initializers -Wno-deprecated-copy -Wno-noexcept-type -Wnon-virtual-dtor -Wdelete-non-virtual-dtor -ffp-contract=on -Wno-range-loop-analysis -O3 -DNDEBUG
